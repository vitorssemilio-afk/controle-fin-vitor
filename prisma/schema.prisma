// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts              FinancialAccount[]
  categories            Category[]
  transactions          Transaction[]
  creditCards           CreditCard[]
  invoices              Invoice[]
  cardTransactions      CardTransaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]

  @@map("users")
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  INVESTMENT
}

model FinancialAccount {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  currency       String      @default("BRL")
  initialBalance Decimal     @default(0) @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionsOut       Transaction[]          @relation("AccountTransactions")
  transactionsIn        Transaction[]          @relation("TransferDestination")
  invoicePayments       Invoice[]              @relation("InvoicePaymentAccount")
  recurringTransactions RecurringTransaction[]
  savingsGoals          SavingsGoal[]

  @@index([userId])
  @@map("financial_accounts")
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  kind      CategoryKind
  color     String       @default("#6B655C")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  cardTransactions      CardTransaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]

  @@unique([userId, name, kind])
  @@index([userId])
  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  CARD_PAYMENT
}

model Transaction {
  id                     String          @id @default(cuid())
  userId                 String
  accountId              String
  transferAccountId      String?
  categoryId             String?
  recurringTransactionId String?
  type                   TransactionType
  amount                 Decimal         @db.Decimal(12, 2)
  date                   DateTime        @db.Date
  description            String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              FinancialAccount      @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount      FinancialAccount?     @relation("TransferDestination", fields: [transferAccountId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  invoicePayment       Invoice?

  @@index([userId, date])
  @@index([accountId])
  @@map("transactions")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id                String              @id @default(cuid())
  userId            String
  accountId         String
  categoryId        String
  type              TransactionType
  amount            Decimal             @db.Decimal(12, 2)
  description       String?
  frequency         RecurrenceFrequency
  startDate         DateTime            @db.Date
  endDate           DateTime?           @db.Date
  lastGeneratedDate DateTime?           @db.Date
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category         @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@map("recurring_transactions")
}

model Budget {
  id             String   @id @default(cuid())
  userId         String
  categoryId     String
  referenceMonth DateTime @db.Date
  limitAmount    Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, referenceMonth])
  @@index([userId])
  @@map("budgets")
}

model CreditCard {
  id         String   @id @default(cuid())
  userId     String
  name       String
  closingDay Int
  dueDay     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@map("credit_cards")
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
}

model Invoice {
  id                   String        @id @default(cuid())
  userId               String
  cardId               String
  closingDate          DateTime      @db.Date
  dueDate              DateTime      @db.Date
  status               InvoiceStatus @default(OPEN)
  paidAt               DateTime?
  paymentAccountId     String?
  paymentTransactionId String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  card               CreditCard        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  paymentAccount     FinancialAccount? @relation("InvoicePaymentAccount", fields: [paymentAccountId], references: [id])
  paymentTransaction Transaction?      @relation(fields: [paymentTransactionId], references: [id])
  cardTransactions   CardTransaction[]

  @@unique([cardId, closingDate])
  @@index([userId])
  @@map("invoices")
}

model CardTransaction {
  id                String   @id @default(cuid())
  userId            String
  invoiceId         String
  categoryId        String
  purchaseGroupId   String
  installmentNumber Int      @default(1)
  installmentCount  Int      @default(1)
  description       String?
  amount            Decimal  @db.Decimal(12, 2)
  purchaseDate      DateTime @db.Date
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([invoiceId])
  @@index([purchaseGroupId])
  @@map("card_transactions")
}

model SavingsGoal {
  id              String   @id @default(cuid())
  userId          String
  name            String
  targetAmount    Decimal  @db.Decimal(12, 2)
  targetDate      DateTime @db.Date
  linkedAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAccount FinancialAccount? @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("savings_goals")
}
