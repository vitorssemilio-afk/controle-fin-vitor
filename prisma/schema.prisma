// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     FinancialAccount[]
  categories   Category[]
  transactions Transaction[]

  @@map("users")
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  INVESTMENT
}

model FinancialAccount {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  currency       String      @default("BRL")
  initialBalance Decimal     @default(0) @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionsOut Transaction[] @relation("AccountTransactions")
  transactionsIn  Transaction[] @relation("TransferDestination")

  @@index([userId])
  @@map("financial_accounts")
}

enum CategoryKind {
  INCOME
  EXPENSE
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  kind      CategoryKind
  color     String       @default("#6B655C")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name, kind])
  @@index([userId])
  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Transaction {
  id                String          @id @default(cuid())
  userId            String
  accountId         String
  transferAccountId String?
  categoryId        String?
  type              TransactionType
  amount            Decimal         @db.Decimal(12, 2)
  date              DateTime        @db.Date
  description       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         FinancialAccount  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount FinancialAccount? @relation("TransferDestination", fields: [transferAccountId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId])
  @@map("transactions")
}
